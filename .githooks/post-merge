#!/bin/bash
# Auto clean-install when package-lock.json changes after git pull/merge

# Guard: abort if wrong Node version (prevents broken npm ci)
REQUIRED_MAJOR="24"
CURRENT_MAJOR=$(node -v 2>/dev/null | cut -d'.' -f1 | tr -d 'v')
if [ "$CURRENT_MAJOR" != "$REQUIRED_MAJOR" ]; then
  echo ""
  echo "⚠ Post-merge hook skipped: Node ${REQUIRED_MAJOR}.x required, you have $(node -v)"
  echo "  Run: nvm use && npm run fresh"
  echo ""
  exit 0
fi

changed_files="$(git diff-tree -r --name-only --no-commit-id ORIG_HEAD HEAD)"

if echo "$changed_files" | grep -q "package-lock.json"; then
  echo ""
  echo "╔══════════════════════════════════════════╗"
  echo "║  package-lock.json changed — rebuilding  ║"
  echo "╚══════════════════════════════════════════╝"
  echo ""
  rm -rf node_modules .wxt .output
  npm ci
  npx wxt build
  echo ""
  echo "Auto-rebuild complete. Extension ready in .output/chrome-mv3/"
  echo ""
elif echo "$changed_files" | grep -qE "\.(ts|tsx|html|css|js)$"; then
  echo ""
  echo "Source files changed. Rebuilding extension..."
  rm -rf .wxt .output
  npx wxt build
  echo ""
  echo "Rebuild complete. Reload extension in Chrome."
  echo ""
fi
