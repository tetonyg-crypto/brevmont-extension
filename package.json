{
  "name": "brevmont-extension",
  "version": "1.10.1",
  "description": "Brevmont Chrome Extension — AI Sales Assistant",
  "main": "index.js",
  "scripts": {
    "build": "wxt build",
    "build:dev": "wxt build && bash .scripts/tg.sh \"[EXTENSION DEV BUILD] v$npm_package_version complete. Reload extension at chrome://extensions and hard-refresh VinSolutions.\"",
    "build:release": "wxt build && wxt zip",
    "dev": "wxt dev",
    "zip": "wxt zip",
    "test": "echo \"No tests yet\"",
    "clean": "rm -rf node_modules .wxt .output",
    "fresh": "npm run clean && npm ci && npm run build",
    "setup": "bash setup.sh",
    "prepare": "git config core.hooksPath .githooks"
  },
  "engines": {
    "node": ">=24.0.0",
    "npm": ">=11.0.0"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "@tailwindcss/postcss": "^4.2.2",
    "clsx": "^2.1.1",
    "lucide-react": "^1.7.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "wxt": "^0.20.20"
  },
  "devDependencies": {
    "@thedutchcoder/postcss-rem-to-px": "^0.0.2",
    "@types/chrome": "^0.1.38",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@wxt-dev/module-react": "^1.2.2",
    "autoprefixer": "^10.4.27",
    "postcss": "^8.5.8",
    "tailwindcss": "^4.2.2",
    "terser": "^5.46.1",
    "typescript": "^6.0.2"
  }
}
